step 1:
 take the .csr file and encode it using base64.
 Eg: <cat akshay.csr | base64 -w 0>

Step 2:
Create an yaml object as below and apply it to create the certificate signing request
Manifest:

---
apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: akshay
spec:
  groups:
  - system:authenticated
  request: <Paste the base64 encoded value of the CSR file>
  signerName: kubernetes.io/kube-apiserver-client
  usages:
  - client auth

---
apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: akshay
spec:
  groups:
  - system:authenticated
  request: |
    
  signerName: kubernetes.io/kube-apiserver-client
  usages:
  - client auth

Step 3:
 CHeck the status of signing request
 << kubectl get csr >>

Step 4:
 Approve the CSR
 kubectl certificate approve <certificate-signing-request-name>

Step 5:
 Deny a CSR
 << kubectl certificate deny agent-smith >>

Step 6:
 Delete the csr object
 << kubectl certificate deny agent-smith >>
